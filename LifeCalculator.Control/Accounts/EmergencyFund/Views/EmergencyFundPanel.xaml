<UserControl
    x:Class="LifeCalculator.Control.Views.EmergencyFundPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <StackPanel Margin="4">

        <!--  Empty state: one button, and an explanation of what the section is for.  -->
        <Border BorderThickness="1,1,1,3" BorderBrush="{StaticResource BrassBrush}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource LedgerCard}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasFund}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="Start an emergency fund" Style="{StaticResource DisplayText}" FontSize="15" Margin="0,0,0,4" />
                <TextBlock
                    Text="Cash set aside for a job loss or a broken boiler — kept separate from investments because you need it liquid, not growing. Set a target, say what you put aside each month, and see the date you'll be covered."
                    Style="{StaticResource BodyMutedText}" MaxWidth="580" HorizontalAlignment="Left" Margin="0,0,0,14" />
                <Button
                    Content="Start an emergency fund"
                    Command="{Binding CreateFundCommand}"
                    Style="{StaticResource LedgerPrimaryButton}"
                    HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <!--  The fund itself.  -->
        <StackPanel Visibility="{Binding HasFund, Converter={StaticResource BooleanToVisibilityConverter}}">

            <!--  Headline: progress toward the goal, and the date it lands.  -->
            <Border Style="{StaticResource LedgerCard}" BorderThickness="1,1,1,3" BorderBrush="{StaticResource BrassBrush}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SAVED SO FAR" Style="{StaticResource EyebrowText}" Foreground="{StaticResource InkMutedBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding CurrentBalance, StringFormat=C0}" Style="{StaticResource DataFigureText}" FontSize="34" />
                                <TextBlock Text="of" Style="{StaticResource BodyMutedText}" VerticalAlignment="Bottom" Margin="8,0,6,6" />
                                <TextBlock Text="{Binding GoalAmount, StringFormat=C0}" Style="{StaticResource DataFigureText}" FontSize="20" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                            </StackPanel>
                            <TextBlock Text="{Binding GoalDescription}" Style="{StaticResource BodyMutedText}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:0}%}" Style="{StaticResource DataFigureText}" FontSize="20" HorizontalAlignment="Right" />
                            <TextBlock Text="funded" Style="{StaticResource BodyMutedText}" FontSize="11" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar
                        Height="8" Margin="0,14,0,0"
                        Minimum="0" Maximum="100"
                        Value="{Binding ProgressPercent, Mode=OneWay}"
                        Background="{StaticResource HairlineBrush}"
                        Foreground="{StaticResource SageBrush}"
                        BorderThickness="0" />

                    <TextBlock Text="{Binding ProjectionText}" Style="{StaticResource BodyMutedText}" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding MonthsCoveredText}" Style="{StaticResource BodyMutedText}" FontSize="11" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!--
                Goal presets. Three months is the usual floor, six the standard advice, twelve
                for variable income — each button shows the figure it would set, so the choice is
                made against a real number rather than a rule of thumb.
            -->
            <Border Style="{StaticResource LedgerCard}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Set a goal from your budget" Style="{StaticResource DisplayText}" FontSize="15" Margin="0,0,0,4" />

                    <TextBlock
                        Style="{StaticResource BodyMutedText}" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <Run Text="Based on" />
                        <Run Text="{Binding MonthlyExpenses, StringFormat=C0, Mode=OneWay}" FontFamily="{StaticResource DataFontFamily}" />
                        <Run Text="a month in expenses from your Budget." />
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasExpenses, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Command="{Binding SetGoalMonthsCommand}" CommandParameter="3" Style="{StaticResource LedgerSecondaryButton}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="3 months" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding ThreeMonthGoal, StringFormat=C0}" FontFamily="{StaticResource DataFontFamily}" FontSize="11" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SetGoalMonthsCommand}" CommandParameter="6" Style="{StaticResource LedgerSecondaryButton}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="6 months" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding SixMonthGoal, StringFormat=C0}" FontFamily="{StaticResource DataFontFamily}" FontSize="11" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SetGoalMonthsCommand}" CommandParameter="12" Style="{StaticResource LedgerSecondaryButton}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="12 months" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding TwelveMonthGoal, StringFormat=C0}" FontFamily="{StaticResource DataFontFamily}" FontSize="11" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!--  Without a budget the presets would all read $0, so say why instead.  -->
                    <Border Background="{StaticResource ParchmentBrush}" Padding="12" CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasExpenses}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            Text="Add your monthly expenses on the Budget screen and the 3, 6, and 12-month goals will fill in here automatically."
                            Style="{StaticResource BodyMutedText}" FontSize="11" TextWrapping="Wrap" MaxWidth="580" HorizontalAlignment="Left" />
                    </Border>
                </StackPanel>
            </Border>

            <!--  The numbers behind it.  -->
            <Border Style="{StaticResource LedgerCard}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Fund details" Style="{StaticResource DisplayText}" FontSize="15" Margin="0,0,0,12" />

                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="CURRENT BALANCE" Style="{StaticResource EyebrowText}" Margin="0,0,0,3" />
                            <TextBox Style="{StaticResource ValidatingTextBox}" Text="{Binding CurrentBalance, ValidatesOnNotifyDataErrors=True, StringFormat=C}" />
                        </StackPanel>

                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="SAVED EACH MONTH" Style="{StaticResource EyebrowText}" Margin="0,0,0,3" />
                            <TextBox Style="{StaticResource ValidatingTextBox}" Text="{Binding MonthlyContribution, ValidatesOnNotifyDataErrors=True, StringFormat=C}" />
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="INTEREST RATE (APY)" Style="{StaticResource EyebrowText}" Margin="0,0,0,3" />
                            <TextBox Style="{StaticResource ValidatingTextBox}" Text="{Binding InterestRate, ValidatesOnNotifyDataErrors=True, StringFormat={}{0}%}" />
                        </StackPanel>
                    </UniformGrid>

                    <UniformGrid Columns="3" Margin="0,12,0,0">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="GOAL AMOUNT" Style="{StaticResource EyebrowText}" Margin="0,0,0,3" />
                            <TextBox Style="{StaticResource ValidatingTextBox}" Text="{Binding GoalAmount, ValidatesOnNotifyDataErrors=True, StringFormat=C}" />
                        </StackPanel>

                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="FUND NAME" Style="{StaticResource EyebrowText}" Margin="0,0,0,3" />
                            <TextBox Style="{StaticResource ValidatingTextBox}" Text="{Binding Name, ValidatesOnNotifyDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text=" " Style="{StaticResource EyebrowText}" Margin="0,0,0,3" />
                            <Button
                                Content="Delete fund"
                                Command="{Binding DeleteFundCommand}"
                                Style="{StaticResource LedgerSecondaryButton}"
                                HorizontalAlignment="Left" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
