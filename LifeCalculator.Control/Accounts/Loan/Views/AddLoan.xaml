<UserControl
    x:Class="LifeCalculator.Control.Views.AddLoan"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="4" Width="320">
        <TextBlock Text="ACCOUNT NAME" Style="{StaticResource EyebrowText}" Margin="0,6,0,3" />
        <TextBox Style="{StaticResource ValidatingTextBox}" Text="{Binding AccountName, ValidatesOnNotifyDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="START DATE" Style="{StaticResource EyebrowText}" Margin="0,10,0,3" />
        <DatePicker Text="{Binding StartDate}" />

        <TextBlock Text="LOAN AMOUNT" Style="{StaticResource EyebrowText}" Margin="0,10,0,3" />
        <TextBox Style="{StaticResource ValidatingTextBox}" Text="{Binding InitialLoanAmount, ValidatesOnNotifyDataErrors=True, StringFormat=C}" />

        <TextBlock Text="INTEREST RATE" Style="{StaticResource EyebrowText}" Margin="0,10,0,3" />
        <TextBox Style="{StaticResource ValidatingTextBox}" Text="{Binding InterestRate, ValidatesOnNotifyDataErrors=True, StringFormat={}{0}%}" />

        <TextBlock Text="LENGTH (YEARS)" Style="{StaticResource EyebrowText}" Margin="0,10,0,3" />
        <TextBox Style="{StaticResource ValidatingTextBox}" Text="{Binding LoanLength, ValidatesOnNotifyDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="DOWN PAYMENT" Style="{StaticResource EyebrowText}" Margin="0,10,0,3" />
        <TextBox Style="{StaticResource ValidatingTextBox}" Text="{Binding DownPayment, ValidatesOnNotifyDataErrors=True, StringFormat=C}" />

        <Button
            Margin="0,16,0,0" HorizontalAlignment="Right"
            Command="{Binding AddAccountCommand}"
            Content="Add Loan"
            Style="{StaticResource LedgerPrimaryButton}" />
    </StackPanel>
</UserControl>
