<UserControl x:Class="LifeCalculator.Control.Views.ModifyCompound"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LifeCalculator.Control.Views"
             xmlns:localVM="clr-namespace:LifeCalculator.Control.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- column 0 -->

        <StackPanel Grid.Row="0" Grid.Column="0">
            <StackPanel Orientation="Horizontal">
                <Label Content="Name : " Width="100" Height="24"/>
                <TextBox Text="{Binding Name}" Width="100" Height="24"/>
            </StackPanel>

        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1">

            <StackPanel Orientation="Horizontal">
                <Label Content="Initial Amount : " Width="100" Height="24"/>
                <TextBox Text="{Binding InitialAmount, StringFormat=C}" Width="100" Height="24"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Content="Interest Rate : " Width="100" Height="24"/>
                <TextBox Text="{Binding InterestRate, StringFormat={}{0}%}" Width="100" Height="24"/>
            </StackPanel>
            
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="2">

            <StackPanel Orientation="Horizontal">
                <Label Content="Start Date : " Width="100" Height="24"/>
                <DatePicker SelectedDate="{Binding StartDate}" Width="100" Height="24"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Content="Stop Date : " Width="100" Height="24"/>
                <DatePicker SelectedDate="{Binding EndDate}" Width="100" Height="24"/>
            </StackPanel>

            <StackPanel>
                <Button x:Name="DeleteAccount" Content="Delete" Command="{Binding DeleteAccountCommand}" Width="100" Margin="10"/>
            </StackPanel>
            
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
            <TextBlock Text="Events" FontWeight="SemiBold" Margin="4,0,0,4" />
            <ItemsControl ItemsSource="{Binding AccountLifeEventsVMs}">
                <ItemsControl.Resources>
                    <DataTemplate DataType="{x:Type localVM:ModifyEventViewModel}">
                        <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Background="#FAFAFA" Margin="0,3" Padding="6">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <local:ModifyEvent />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.Resources>
            </ItemsControl>
        </StackPanel>

    </Grid>
</UserControl>
