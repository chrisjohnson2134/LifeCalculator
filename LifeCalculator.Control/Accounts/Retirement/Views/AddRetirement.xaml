<UserControl
    x:Class="LifeCalculator.Control.Views.AddRetirement"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:LifeCalculator.Control.ViewModels">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <StackPanel Margin="4" Width="300">
        <TextBlock Text="ACCOUNT NAME" Style="{StaticResource EyebrowText}" Margin="0,6,0,3" />
        <TextBox Style="{StaticResource ValidatingTextBox}" Text="{Binding AccountName, ValidatesOnNotifyDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="ACCOUNT TYPE" Style="{StaticResource EyebrowText}" Margin="0,10,0,3" />
        <ComboBox Style="{StaticResource EnumComboBox}" ItemsSource="{Binding AccountKinds}" SelectedItem="{Binding AccountKind}" />

        <TextBlock Text="INITIAL AMOUNT" Style="{StaticResource EyebrowText}" Margin="0,10,0,3" />
        <TextBox Style="{StaticResource ValidatingTextBox}" Text="{Binding InitialValue, ValidatesOnNotifyDataErrors=True, StringFormat=C}" />

        <TextBlock Text="GROWTH RATE" Style="{StaticResource EyebrowText}" Margin="0,10,0,3" />
        <TextBox Style="{StaticResource ValidatingTextBox}" Text="{Binding Interest, ValidatesOnNotifyDataErrors=True, StringFormat={}{0}%}" />

        <TextBlock Text="CONTRIBUTION" Style="{StaticResource EyebrowText}" Margin="0,10,0,3" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
            <RadioButton
                Style="{StaticResource SegmentedToggle}" GroupName="ContributionBasis" Content="Percent of salary"
                IsChecked="{Binding ContributionBasis, Converter={StaticResource EqualValueToParameterConverter}, ConverterParameter=PercentOfSalary}" />
            <RadioButton
                Style="{StaticResource SegmentedToggle}" GroupName="ContributionBasis" Content="Dollar amount"
                IsChecked="{Binding ContributionBasis, Converter={StaticResource EqualValueToParameterConverter}, ConverterParameter=DollarAmount}" />
        </StackPanel>

        <!--
            Both boxes share a cell — only the one matching the selected basis is shown, so the
            other can be refreshed from the source without fighting whatever is being typed.
            The grey figure beside it is the derived counterpart, and is display-only.
        -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0" Style="{StaticResource ValidatingTextBox}"
                Visibility="{Binding IsPercentBasis, Converter={StaticResource BooleanToVisibilityConverter}}"
                Text="{Binding ContributionPercent, ValidatesOnNotifyDataErrors=True, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0}%}" />

            <TextBox
                Grid.Column="0" Style="{StaticResource ValidatingTextBox}"
                Visibility="{Binding IsDollarBasis, Converter={StaticResource BooleanToVisibilityConverter}}"
                Text="{Binding Contribute, ValidatesOnNotifyDataErrors=True, UpdateSourceTrigger=PropertyChanged, StringFormat=C}" />

            <TextBlock
                Grid.Column="1" Text="{Binding ContributionEquivalentText}"
                Style="{StaticResource BodyMutedText}" FontFamily="{StaticResource DataFontFamily}" FontSize="11"
                VerticalAlignment="Center" Margin="8,0,0,0" />
        </Grid>

        <TextBlock Text="{Binding ContributionBasisHint}" Style="{StaticResource BodyMutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />

        <TextBlock Text="INCOME STREAM" Style="{StaticResource EyebrowText}" Margin="0,10,0,3" />
        <ComboBox ItemsSource="{Binding IncomeStreams}" SelectedItem="{Binding LinkedIncomeStream}" DisplayMemberPath="Display" />
        <TextBlock Text="The job this account belongs to — its salary sets the match cap." Style="{StaticResource BodyMutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />

        <TextBlock Text="EMPLOYER MATCH %" Style="{StaticResource EyebrowText}" Margin="0,10,0,3" />
        <TextBox Style="{StaticResource ValidatingTextBox}" Text="{Binding EmployerMatchPercent, ValidatesOnNotifyDataErrors=True, StringFormat={}{0}%}" />
        <TextBlock Text="e.g. 50 = employer matches 50% of your contribution" Style="{StaticResource BodyMutedText}" FontSize="11" Margin="0,2,0,0" />

        <TextBlock Text="MATCH CAP %" Style="{StaticResource EyebrowText}" Margin="0,10,0,3" />
        <TextBox Style="{StaticResource ValidatingTextBox}" Text="{Binding EmployerMatchCapPercentOfSalary, ValidatesOnNotifyDataErrors=True, StringFormat={}{0}%}" />
        <TextBlock Text="e.g. 6 = match applies up to 6% of your salary" Style="{StaticResource BodyMutedText}" FontSize="11" Margin="0,2,0,0" />

        <TextBlock Text="START DATE" Style="{StaticResource EyebrowText}" Margin="0,10,0,3" />
        <DatePicker SelectedDate="{Binding StartDate}" />

        <TextBlock Text="STOP DATE" Style="{StaticResource EyebrowText}" Margin="0,10,0,3" />
        <DatePicker Style="{StaticResource ValidatingDatePicker}" SelectedDate="{Binding StopDate, ValidatesOnNotifyDataErrors=True}" />

        <Button
            Margin="0,16,0,0" HorizontalAlignment="Right"
            Command="{Binding AddAccountCommand}"
            Content="Add Retirement Account"
            Style="{StaticResource LedgerPrimaryButton}" />
    </StackPanel>
</UserControl>
