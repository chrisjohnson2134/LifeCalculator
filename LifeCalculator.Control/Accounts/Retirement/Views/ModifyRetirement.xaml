<UserControl x:Class="LifeCalculator.Control.Views.ModifyRetirement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LifeCalculator.Control.Views"
             xmlns:localVM="clr-namespace:LifeCalculator.Control.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <StackPanel Margin="6">
        <UniformGrid Columns="3">
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="NAME" Style="{StaticResource EyebrowText}" Margin="0,0,0,3" />
                <TextBox Style="{StaticResource ValidatingTextBox}" Text="{Binding Name, ValidatesOnNotifyDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="ACCOUNT TYPE" Style="{StaticResource EyebrowText}" Margin="0,0,0,3" />
                <ComboBox Style="{StaticResource EnumComboBox}" ItemsSource="{Binding AccountKinds}" SelectedItem="{Binding AccountKind}" />
            </StackPanel>

            <StackPanel>
                <TextBlock Text="INITIAL AMOUNT" Style="{StaticResource EyebrowText}" Margin="0,0,0,3" />
                <TextBox Style="{StaticResource ValidatingTextBox}" Text="{Binding InitialAmount, ValidatesOnNotifyDataErrors=True, StringFormat=C}" />
            </StackPanel>
        </UniformGrid>

        <UniformGrid Columns="3" Margin="0,12,0,0">
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="GROWTH RATE" Style="{StaticResource EyebrowText}" Margin="0,0,0,3" />
                <TextBox Style="{StaticResource ValidatingTextBox}" Text="{Binding InterestRate, ValidatesOnNotifyDataErrors=True, StringFormat={}{0}%}" />
            </StackPanel>

            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="EMPLOYER MATCH %" Style="{StaticResource EyebrowText}" Margin="0,0,0,3" />
                <TextBox Style="{StaticResource ValidatingTextBox}" Text="{Binding EmployerMatchPercent, ValidatesOnNotifyDataErrors=True, StringFormat={}{0}%}" />
            </StackPanel>

            <StackPanel>
                <TextBlock Text="MATCH CAP (% SALARY)" Style="{StaticResource EyebrowText}" Margin="0,0,0,3" />
                <TextBox Style="{StaticResource ValidatingTextBox}" Text="{Binding EmployerMatchCapPercentOfSalary, ValidatesOnNotifyDataErrors=True, StringFormat={}{0}%}" />
            </StackPanel>
        </UniformGrid>

        <UniformGrid Columns="2" Margin="0,12,0,0">
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="LINKED INCOME STREAM" Style="{StaticResource EyebrowText}" Margin="0,0,0,3" />
                <ComboBox ItemsSource="{Binding IncomeStreams}" SelectedItem="{Binding LinkedIncomeStream}" DisplayMemberPath="Display" />
                <TextBlock Text="Its salary sets the employer match cap." Style="{StaticResource BodyMutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel />
        </UniformGrid>

        <UniformGrid Columns="2" Margin="0,12,0,0">
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="START DATE" Style="{StaticResource EyebrowText}" Margin="0,0,0,3" />
                <DatePicker SelectedDate="{Binding StartDate}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="STOP DATE" Style="{StaticResource EyebrowText}" Margin="0,0,0,3" />
                <DatePicker Style="{StaticResource ValidatingDatePicker}" SelectedDate="{Binding EndDate, ValidatesOnNotifyDataErrors=True}" />
            </StackPanel>
        </UniformGrid>

        <Button
            Content="Delete Account" Command="{Binding DeleteAccountCommand}"
            Style="{StaticResource LedgerSecondaryButton}"
            HorizontalAlignment="Left" Margin="0,16,0,0" />

        <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,14" />

        <Button
            Content="+ Add Event" Command="{Binding ToggleAddEventCommand}"
            Style="{StaticResource LedgerSecondaryButton}"
            HorizontalAlignment="Left" />

        <Border
            Style="{StaticResource LedgerCard}" Margin="0,10,0,0"
            Visibility="{Binding IsAddEventOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <local:AddEvent DataContext="{Binding AddEventViewModel}" />
        </Border>

        <TextBlock Text="Events" Style="{StaticResource DisplayText}" FontSize="15" Margin="0,18,0,8" />
        <ItemsControl ItemsSource="{Binding AccountLifeEventsVMs}">
            <ItemsControl.Resources>
                <DataTemplate DataType="{x:Type localVM:ModifyEventViewModel}">
                    <Border Style="{StaticResource LedgerCard}" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <local:ModifyEvent />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.Resources>
        </ItemsControl>
    </StackPanel>
</UserControl>
