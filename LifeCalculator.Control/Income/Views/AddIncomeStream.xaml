<UserControl
    x:Class="LifeCalculator.Control.Views.AddIncomeStream"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <StackPanel>
        <UniformGrid Columns="3">
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="SOURCE NAME" Style="{StaticResource EyebrowText}" Margin="0,0,0,3" />
                <TextBox Style="{StaticResource ValidatingTextBox}" Text="{Binding Name, ValidatesOnNotifyDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="TYPE" Style="{StaticResource EyebrowText}" Margin="0,0,0,3" />
                <ComboBox Style="{StaticResource EnumComboBox}" ItemsSource="{Binding StreamTypes}" SelectedItem="{Binding StreamType}" />
            </StackPanel>

            <StackPanel>
                <TextBlock Text="HOW OFTEN YOU'RE PAID" Style="{StaticResource EyebrowText}" Margin="0,0,0,3" />
                <ComboBox Style="{StaticResource EnumComboBox}" ItemsSource="{Binding PayFrequencies}" SelectedItem="{Binding PayFrequency}" />
            </StackPanel>
        </UniformGrid>

        <UniformGrid Columns="3" Margin="0,12,0,0">
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="{Binding PayRateLabel}" Style="{StaticResource EyebrowText}" Margin="0,0,0,3" />
                <TextBox Style="{StaticResource ValidatingTextBox}" Text="{Binding PayRate, ValidatesOnNotifyDataErrors=True, StringFormat=C}" />
            </StackPanel>

            <!--  Only an hourly rate needs hours to become an annual figure.  -->
            <StackPanel Margin="0,0,16,0" Visibility="{Binding IsHourly, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="HOURS PER WEEK" Style="{StaticResource EyebrowText}" Margin="0,0,0,3" />
                <TextBox Style="{StaticResource ValidatingTextBox}" Text="{Binding HoursPerWeek, ValidatesOnNotifyDataErrors=True}" />
            </StackPanel>

            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="PAYROLL TAX" Style="{StaticResource EyebrowText}" Margin="0,0,0,3" />
                <ComboBox Style="{StaticResource EnumComboBox}" ItemsSource="{Binding TaxTreatments}" SelectedItem="{Binding TaxTreatment}" IsEnabled="{Binding IsGross}" />
            </StackPanel>
        </UniformGrid>

        <!--
            The payoff for asking gross: the user sees what actually lands in their bank,
            without having worked it out. Rates come from the state and filing status set
            once on the Financial Profile, so this stays a single field to fill in.
        -->
        <Border Style="{StaticResource LedgerCard}" Margin="0,16,0,0" Padding="14" BorderThickness="1,1,1,3" BorderBrush="{StaticResource BrassBrush}">
            <StackPanel>
                <TextBlock Text="ESTIMATED TAKE-HOME" Style="{StaticResource EyebrowText}" Foreground="{StaticResource InkMutedBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding EstimatedMonthlyTakeHome, StringFormat=C0}" Style="{StaticResource DataFigureText}" FontSize="26" />
                    <TextBlock Text="/mo" Style="{StaticResource BodyMutedText}" VerticalAlignment="Bottom" Margin="3,0,0,4" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Gross" Style="{StaticResource BodyMutedText}" FontSize="11" />
                    <TextBlock Text="{Binding MonthlyGross, StringFormat=C0}" FontFamily="{StaticResource DataFontFamily}" FontSize="11" Margin="6,0,0,0" />
                    <TextBlock Text="&#8226;" Style="{StaticResource BodyMutedText}" FontSize="11" Margin="8,0" />
                    <TextBlock Text="Est. tax" Style="{StaticResource BodyMutedText}" FontSize="11" />
                    <TextBlock Text="{Binding EstimatedMonthlyTax, StringFormat=C0}" FontFamily="{StaticResource DataFontFamily}" FontSize="11" Margin="6,0,0,0" />
                    <TextBlock Text="&#8226;" Style="{StaticResource BodyMutedText}" FontSize="11" Margin="8,0" />
                    <TextBlock Text="{Binding EffectiveTaxRate, StringFormat={}{0:P1}}" FontFamily="{StaticResource DataFontFamily}" FontSize="11" />
                    <TextBlock Text="effective rate" Style="{StaticResource BodyMutedText}" FontSize="11" Margin="4,0,0,0" />
                </StackPanel>

                <TextBlock
                    Text="Estimated from your state and filing status on the Financial Profile. Federal brackets, Social Security, Medicare, and the standard deduction are all applied. Where you have more than one income, tax is worked out across all of them together, since brackets stack."
                    Style="{StaticResource BodyMutedText}" FontSize="11" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" Margin="0,10,0,0" />

                <CheckBox Content="This income is already after tax (gift, Roth withdrawal, reimbursement)" IsChecked="{Binding IsAlreadyNet}" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <UniformGrid Columns="3" Margin="0,16,0,0">
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="START DATE" Style="{StaticResource EyebrowText}" Margin="0,0,0,3" />
                <DatePicker SelectedDate="{Binding StartDate}" />
            </StackPanel>

            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="END DATE" Style="{StaticResource EyebrowText}" Margin="0,0,0,3" />
                <DatePicker Style="{StaticResource ValidatingDatePicker}" IsEnabled="{Binding HasEndDate}" SelectedDate="{Binding EndDate, ValidatesOnNotifyDataErrors=True}" />
                <CheckBox Content="Has a known end date" IsChecked="{Binding HasEndDate}" Margin="0,8,0,0" />
            </StackPanel>

            <StackPanel VerticalAlignment="Top">
                <TextBlock Text=" " Style="{StaticResource EyebrowText}" Margin="0,0,0,3" />
                <Button
                    Command="{Binding AddIncomeStreamCommand}"
                    Content="Add Income Stream"
                    Style="{StaticResource LedgerPrimaryButton}"
                    HorizontalAlignment="Left" />
            </StackPanel>
        </UniformGrid>
    </StackPanel>
</UserControl>
