<UserControl
    x:Class="LifeCalculator.Control.Views.ModifyEvent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Name:" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="1" Margin="2" Text="{Binding Name}" />

        <Label Grid.Row="0" Grid.Column="3" Content="Amount:" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="4" Margin="2" Text="{Binding Amount, StringFormat=C}" />

        <Label Grid.Row="1" Grid.Column="0" Content="Start Date:" VerticalAlignment="Center" />
        <DatePicker Grid.Row="1" Grid.Column="1" Margin="2" SelectedDate="{Binding Date}" />

        <Label Grid.Row="1" Grid.Column="3" Content="End Date:" VerticalAlignment="Center" />
        <DatePicker Grid.Row="1" Grid.Column="4" Margin="2" SelectedDate="{Binding EndDate}" IsEnabled="{Binding EndDateEnabled}" />
    </Grid>
</UserControl>
