<UserControl
    x:Class="LifeCalculator.Navigation.SideNavigationBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:LifeCalculator.Tools.Common.Converters;assembly=LifeCalculator.Tools"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LifeCalculator.Navigation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:nav="clr-namespace:LifeCalculator.Framework.Enums;assembly=LifeCalculator.Framework"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:EqualValueToParameterConverter x:Key="EqualValueToParameterConverter" />

        <Style x:Key="NavItem" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="#C9CFB8" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#16202B" />
                            </Trigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#16202B" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrassBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource ParchmentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Width="180" Background="{StaticResource InkBrush}">
        <StackPanel>
            <TextBlock
                Text="Life Calculator"
                Foreground="{StaticResource ParchmentBrush}"
                FontFamily="{StaticResource DisplayFontFamily}"
                FontSize="18" FontWeight="SemiBold"
                TextWrapping="Wrap"
                Margin="20,26,16,10" />
            <Border BorderBrush="#33404C" BorderThickness="0,0,0,1" Margin="20,0,20,16" />

            <Button
                x:Name="Home" Style="{StaticResource NavItem}" Content="Home"
                Command="{Binding UpdateCurrentViewModelCommand}" CommandParameter="{x:Static nav:ViewType.Home}"
                Tag="{Binding CurrentViewType, Converter={StaticResource EqualValueToParameterConverter}, ConverterParameter=Home}" />
            <Button
                x:Name="FinancialProfile" Style="{StaticResource NavItem}" Content="Financial Profile"
                Command="{Binding UpdateCurrentViewModelCommand}" CommandParameter="{x:Static nav:ViewType.FinancialProfile}"
                Tag="{Binding CurrentViewType, Converter={StaticResource EqualValueToParameterConverter}, ConverterParameter=FinancialProfile}" />
            <Button
                x:Name="Budget" Style="{StaticResource NavItem}" Content="Budget"
                Command="{Binding UpdateCurrentViewModelCommand}" CommandParameter="{x:Static nav:ViewType.Budget}"
                Tag="{Binding CurrentViewType, Converter={StaticResource EqualValueToParameterConverter}, ConverterParameter=Budget}" />
            <Button
                x:Name="Calculator" Style="{StaticResource NavItem}" Content="Life Calculator"
                Command="{Binding UpdateCurrentViewModelCommand}" CommandParameter="{x:Static nav:ViewType.Calculator}"
                Tag="{Binding CurrentViewType, Converter={StaticResource EqualValueToParameterConverter}, ConverterParameter=Calculator}" />
            <Button
                x:Name="Settings" Style="{StaticResource NavItem}" Content="Settings" Margin="0,30,0,0"
                Command="{Binding UpdateCurrentViewModelCommand}" CommandParameter="{x:Static nav:ViewType.Settings}"
                Tag="{Binding CurrentViewType, Converter={StaticResource EqualValueToParameterConverter}, ConverterParameter=Settings}" />
            <Button x:Name="LogoutButton" Style="{StaticResource NavItem}" Content="Log Out" Command="{Binding LogoutCommand}" Foreground="{StaticResource BrassBrush}" Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
