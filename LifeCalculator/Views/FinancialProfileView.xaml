<UserControl
    x:Class="LifeCalculator.Views.FinancialProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controlViewModels="clr-namespace:LifeCalculator.Control.ViewModels;assembly=LifeCalculator.Control"
    xmlns:controlViews="clr-namespace:LifeCalculator.Control.Views;assembly=LifeCalculator.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LifeCalculator.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Background="{StaticResource ParchmentBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32" MaxWidth="1000" HorizontalAlignment="Left">

                <TextBlock Text="MONEY IN" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="Income" Style="{StaticResource DisplayLargeText}" Margin="0,4,0,6" />
                <TextBlock
                    Text="What you earn each month. This drives the monthly surplus on your Life Calculator."
                    Style="{StaticResource BodyMutedText}" MaxWidth="620" HorizontalAlignment="Left" Margin="0,0,0,22" />

                <!--  Summary: all three describe income, so they move together when a stream changes.  -->
                <UniformGrid Rows="1" Margin="0,0,0,26">
                    <Border Style="{StaticResource LedgerCard}" Margin="0,0,10,0" BorderThickness="1,1,1,3" BorderBrush="{StaticResource SageBrush}">
                        <StackPanel>
                            <TextBlock Text="MONTHLY TAKE-HOME" Style="{StaticResource EyebrowText}" Foreground="{StaticResource InkMutedBrush}" />
                            <TextBlock Text="{Binding TotalMonthlyIncome, StringFormat=C0}" Style="{StaticResource DataFigureText}" FontSize="24" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource LedgerCard}" BorderThickness="1,1,1,3" BorderBrush="{StaticResource BrassBrush}">
                        <StackPanel>
                            <TextBlock Text="ANNUAL TAKE-HOME" Style="{StaticResource EyebrowText}" Foreground="{StaticResource InkMutedBrush}" />
                            <TextBlock Text="{Binding AnnualTakeHome, StringFormat=C0}" Style="{StaticResource DataFigureText}" FontSize="24" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!--  Income streams: the main content of the page.  -->
                <TextBlock Text="Income streams" Style="{StaticResource DisplayText}" Margin="0,0,0,4" />
                <TextBlock
                    Text="Enter what actually hits your bank each month — no tax math needed. If a job has a 401(k), add its gross salary under &quot;Retirement matching&quot; so the employer match can be sized correctly."
                    Style="{StaticResource BodyMutedText}" MaxWidth="620" HorizontalAlignment="Left" Margin="0,0,0,12" />

                <Button
                    Content="+ Add Income Stream" Command="{Binding ToggleAddIncomeCommand}"
                    Style="{StaticResource LedgerSecondaryButton}" HorizontalAlignment="Left" />

                <Border
                    Style="{StaticResource LedgerCard}" Margin="0,10,0,0"
                    Visibility="{Binding IsAddIncomeOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controlViews:AddIncomeStream DataContext="{Binding AddIncomeStreamViewModel}" />
                </Border>

                <ItemsControl ItemsSource="{Binding IncomeStreams}" Margin="0,14,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type controlViewModels:ModifyIncomeStreamViewModel}">
                            <Border Style="{StaticResource LedgerCard}" Margin="0,0,0,8">
                                <controlViews:ModifyIncomeStream />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="No income streams yet — add your salary, freelance work, or rental income above.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyMutedText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IncomeStreams.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!--
                    Open by default: income is entered gross, so these two settings are what
                    turn it into a take-home figure. Left unset, every number on this page and
                    the Life Calculator's surplus would be estimated against the wrong rate.
                -->
                <Expander Margin="0,28,0,0" IsExpanded="True">
                    <Expander.Header>
                        <TextBlock Text="Where you pay tax" Style="{StaticResource DisplayText}" FontSize="15" />
                    </Expander.Header>

                    <Border Style="{StaticResource LedgerCard}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock
                                Text="Set these once and every income stream is converted to take-home for you. All your gross income is taxed together at your real marginal rate, since brackets stack across total income. Saved automatically."
                                Style="{StaticResource BodyMutedText}" MaxWidth="620" HorizontalAlignment="Left" Margin="0,0,0,16" />

                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="STATE" Style="{StaticResource EyebrowText}" Margin="0,0,0,3" />
                                    <ComboBox
                                        ItemsSource="{Binding States}"
                                        SelectedItem="{Binding SelectedState}"
                                        DisplayMemberPath="Display" />
                                    <TextBlock Text="Fills in an approximate state rate for you." Style="{StaticResource BodyMutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="FILING STATUS" Style="{StaticResource EyebrowText}" Margin="0,0,0,3" />
                                    <ComboBox Style="{StaticResource EnumComboBox}" ItemsSource="{Binding FilingStatuses}" SelectedItem="{Binding FilingStatus}" />
                                </StackPanel>
                            </UniformGrid>

                            <UniformGrid Columns="2" Margin="0,14,0,0">
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="STATE TAX RATE" Style="{StaticResource EyebrowText}" Margin="0,0,0,3" />
                                    <TextBox Style="{StaticResource ValidatingTextBox}" Text="{Binding StateTaxRatePercent, ValidatesOnNotifyDataErrors=True, StringFormat={}{0}%}" />
                                    <TextBlock Text="Override if you know your actual rate." Style="{StaticResource BodyMutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="PRE-TAX DEDUCTIONS/YR" Style="{StaticResource EyebrowText}" Margin="0,0,0,3" />
                                    <TextBox Style="{StaticResource ValidatingTextBox}" Text="{Binding PreTaxDeductionsAnnual, ValidatesOnNotifyDataErrors=True, StringFormat=C}" />
                                    <TextBlock Text="Traditional 401(k), HSA, health premiums." Style="{StaticResource BodyMutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </UniformGrid>

                            <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,16" />

                            <!--  Explains a $0 breakdown instead of letting it look broken.  -->
                            <Border Background="{StaticResource ParchmentBrush}" Padding="12" CornerRadius="4" Margin="0,0,0,14">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasGrossStreams}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock
                                    Text="Nothing to estimate yet — none of your income streams are marked gross. Tick &quot;gross (pre-tax)&quot; on a stream above and the tax breakdown will fill in."
                                    Style="{StaticResource BodyMutedText}" TextWrapping="Wrap" MaxWidth="580" HorizontalAlignment="Left" />
                            </Border>

                            <!--  Breakdown  -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Federal income tax" Style="{StaticResource BodyMutedText}" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TaxEstimate.FederalTax, StringFormat=C0}" FontFamily="{StaticResource DataFontFamily}" FontSize="13" Margin="0,0,0,6" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Social Security" Style="{StaticResource BodyMutedText}" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TaxEstimate.SocialSecurityTax, StringFormat=C0}" FontFamily="{StaticResource DataFontFamily}" FontSize="13" Margin="0,0,0,6" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Medicare" Style="{StaticResource BodyMutedText}" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TaxEstimate.MedicareTax, StringFormat=C0}" FontFamily="{StaticResource DataFontFamily}" FontSize="13" Margin="0,0,0,6" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Self-employment tax" Style="{StaticResource BodyMutedText}" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TaxEstimate.SelfEmploymentTax, StringFormat=C0}" FontFamily="{StaticResource DataFontFamily}" FontSize="13" Margin="0,0,0,6" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="State income tax" Style="{StaticResource BodyMutedText}" Margin="0,0,0,10" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TaxEstimate.StateTax, StringFormat=C0}" FontFamily="{StaticResource DataFontFamily}" FontSize="13" Margin="0,0,0,10" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Estimated take-home per month" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TaxEstimate.TotalNetMonthly, StringFormat=C0}" Style="{StaticResource DataFigureText}" FontSize="20" Foreground="{StaticResource SageBrush}" />
                            </Grid>

                            <TextBlock
                                Text="{Binding TaxYearText}"
                                Style="{StaticResource BodyMutedText}" FontSize="11" Margin="0,14,0,0" />
                            <TextBlock
                                Text="Estimate only. State rates are approximate and exclude local/city taxes; federal figures assume the standard deduction and no credits. Check against a real pay stub."
                                Style="{StaticResource BodyMutedText}" FontSize="11" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
