<UserControl
    x:Class="LifeCalculator.Views.FinancialProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editcontrol="clr-namespace:LifeCalculator.Control.FinancialProfileEdit;assembly=LifeCalculator.Control"
    xmlns:local="clr-namespace:LifeCalculator.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:summaryControl="clr-namespace:LifeCalculator.Control.FinancialProfileSummary;assembly=LifeCalculator.Control"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="booltovis" />
        </Grid.Resources>

        <materialDesign:Card Grid.Row="0" Margin="20,20,20,10" Background="White"
                             Padding="20" materialDesign:ShadowAssist.ShadowDepth="Depth1">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Bank" Width="28" Height="28" Foreground="#1976D2"
                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Financial Profile" FontSize="24" FontWeight="Bold"
                           Foreground="#1976D2" VerticalAlignment="Center"/>
            </StackPanel>
        </materialDesign:Card>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,0,20,10">
            <Grid>
                <ContentControl>
                    <editcontrol:FinancialProfileEditView Visibility="{Binding EditViewVisible, Converter={StaticResource booltovis}}" />
                </ContentControl>

                <ContentControl>
                    <summaryControl:FinancialProfileSummaryView Visibility="{Binding SummaryViewVisible, Converter={StaticResource booltovis}}" />
                </ContentControl>
            </Grid>
        </ScrollViewer>

        <materialDesign:Card Grid.Row="2" Background="White" Padding="20,15"
                             BorderThickness="0,1,0,0" BorderBrush="#E0E0E0"
                             materialDesign:ShadowAssist.ShadowDepth="Depth1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="120" Height="40" Margin="0,0,10,0"
                        Command="{Binding EditViewCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Visibility="{Binding SummaryViewVisible, Converter={StaticResource booltovis}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Edit" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Width="120" Height="40"
                        Command="{Binding SummaryViewCommand}"
                        Background="#4CAF50" Foreground="White"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Visibility="{Binding EditViewVisible, Converter={StaticResource booltovis}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Save" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
