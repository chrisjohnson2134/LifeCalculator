<UserControl x:Class="LifeCalculator.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:tabData="clr-namespace:LifeCalculator.Control.Settings.Interfaces;assembly=LifeCalculator.Control"
             xmlns:views="clr-namespace:LifeCalculator.Control.Views;assembly=LifeCalculator.Control"
             xmlns:viewModels="clr-namespace:LifeCalculator.Control.ViewModels;assembly=LifeCalculator.Control"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0" Margin="20,20,20,10" Background="White"
                             Padding="20" materialDesign:ShadowAssist.ShadowDepth="Depth1">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="SettingsOutline" Width="28" Height="28" Foreground="#1976D2"
                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Settings" FontSize="24" FontWeight="Bold"
                           Foreground="#1976D2" VerticalAlignment="Center"/>
            </StackPanel>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="1" Margin="20,0,20,20"
                             materialDesign:ShadowAssist.ShadowDepth="Depth2"
                             Padding="20">
            <TabControl ItemsSource="{Binding SettingsTabs}"
                        Style="{StaticResource MaterialDesignTabControl}">
                <TabControl.Resources>
                    <DataTemplate DataType="{x:Type viewModels:PlaidDevSettingsViewModel}">
                        <views:PlaidDevSettings/>
                    </DataTemplate>
                </TabControl.Resources>
                <TabControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type tabData:ISettingsViewModel}">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Padding="10,5"/>
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>
        </materialDesign:Card>
    </Grid>
</UserControl>
