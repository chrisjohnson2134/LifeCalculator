<UserControl
    x:Class="LifeCalculator.Views.WelcomePageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        The launch screen is deliberately unlike Login/Register (which are two-pane forms):
        one full-bleed statement, with the app's actual output — a rising net-worth line —
        as the signature element anchoring the bottom of the page.
    -->
    <Grid Background="{StaticResource InkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="720" Margin="40,60,40,0">
            <TextBlock
                Text="LIFE CALCULATOR"
                Foreground="{StaticResource BrassBrush}"
                FontFamily="{StaticResource BodyFontFamily}"
                FontSize="13" FontWeight="SemiBold"
                HorizontalAlignment="Center" />

            <TextBlock
                Text="Every dollar, projected."
                Foreground="{StaticResource ParchmentBrush}"
                FontFamily="{StaticResource DisplayFontFamily}"
                FontSize="64" FontWeight="SemiBold"
                HorizontalAlignment="Center" TextAlignment="Center"
                TextWrapping="Wrap" Margin="0,18,0,0" />

            <Border BorderBrush="{StaticResource BrassBrush}" BorderThickness="0,0,0,2" Width="80" HorizontalAlignment="Center" Margin="0,24,0,24" />

            <TextBlock
                Text="Map your debts, investments, and retirement accounts on one timeline — and find out exactly when you're free of them."
                Foreground="#93A2AB"
                FontFamily="{StaticResource BodyFontFamily}"
                FontSize="16" LineHeight="26"
                HorizontalAlignment="Center" TextAlignment="Center"
                TextWrapping="Wrap" MaxWidth="560" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,38,0,0">
                <Button
                    Width="150" Margin="0,0,12,0"
                    Command="{Binding NavigateToLoginViewCommand}"
                    Content="Log In">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource LedgerPrimaryButton}">
                            <Setter Property="Background" Value="{StaticResource BrassBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrassDarkBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button
                    Width="150"
                    Command="{Binding NavigateToRegisterViewCommand}"
                    Content="Create Account">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource LedgerPrimaryButton}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource ParchmentBrush}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="Transparent" BorderBrush="#3C4C58" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#16202B" />
                                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrassBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </StackPanel>

        <!--
            Signature: the rising net-worth curve the app produces. A Viewbox stretches the
            geometry to whatever width the window is, so it never depends on fixed coordinates.
        -->
        <Grid Grid.Row="1" Height="180" Margin="0,40,0,0">
            <Viewbox Stretch="Fill" VerticalAlignment="Bottom" Height="180">
                <Canvas Width="1000" Height="180">
                    <!--  Filled area under the curve  -->
                    <Polygon Points="0,150 120,138 240,142 380,104 520,112 660,66 820,74 1000,22 1000,180 0,180" Opacity="0.10">
                        <Polygon.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="{StaticResource BrassColor}" />
                                <GradientStop Offset="1" Color="Transparent" />
                            </LinearGradientBrush>
                        </Polygon.Fill>
                    </Polygon>
                    <!--  The curve itself  -->
                    <Polyline
                        Points="0,150 120,138 240,142 380,104 520,112 660,66 820,74 1000,22"
                        Stroke="{StaticResource BrassBrush}"
                        StrokeThickness="2.5"
                        StrokeLineJoin="Round"
                        Opacity="0.75" />
                </Canvas>
            </Viewbox>
        </Grid>
    </Grid>

</UserControl>
