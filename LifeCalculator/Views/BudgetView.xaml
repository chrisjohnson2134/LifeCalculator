<UserControl
    x:Class="LifeCalculator.Views.BudgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controlViews="clr-namespace:LifeCalculator.Control.Views;assembly=LifeCalculator.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:LifeCalculator.Framework.Enums;assembly=LifeCalculator.Framework"
    xmlns:local="clr-namespace:LifeCalculator.Views"
    xmlns:controlsViews="clr-namespace:LifeCalculator.Control.Views;assembly=LifeCalculator.Control"
    xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <material:Card Grid.Row="0" Margin="20,20,20,10" Background="White"
                       Padding="20" material:ShadowAssist.ShadowDepth="Depth1">
            <StackPanel>
                <TextBlock FontSize="24" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,10">
                    <material:PackIcon Kind="AttachMoney" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Run Text="Budget Manager"/>
                </TextBlock>
                <TextBlock Text="Create budget categories and organize them by dragging to set your priorities!"
                           FontSize="14" Foreground="#607D8B" TextWrapping="Wrap"/>
            </StackPanel>
        </material:Card>

        <material:Card Grid.Row="1" Margin="20,10,20,10" Padding="20"
                       material:ShadowAssist.ShadowDepth="Depth2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Add Budget Item" FontSize="16" FontWeight="SemiBold"
                           Foreground="#424242" Margin="0,0,0,15"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Text="Name" Foreground="#424242" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="BudgetItemNameTB" Text="{Binding AddBudgetITemName}"
                                 material:HintAssist.Hint="Budget category name"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,15,0">
                        <TextBlock Text="Planned Amount" Foreground="#424242" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="BudgetItemPlannedAmountTB" Text="{Binding AddBudgetITemPlannedAmount,StringFormat=C}"
                                 material:HintAssist.Hint="$0.00"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </StackPanel>

                    <Button Grid.Column="2" x:Name="AddBudgetItemBtn" Command="{Binding AddBudgetItemCommand}"
                            Content="Add Item" VerticalAlignment="Bottom" Height="40" Padding="20,0"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#1976D2" Foreground="White"/>
                </Grid>
            </Grid>
        </material:Card>

        <material:Card Grid.Row="2" Margin="20,10,20,20" Padding="15"
                       material:ShadowAssist.ShadowDepth="Depth2">
            <controlsViews:TransactionSorterView DataContext="{Binding TransactionSorterControl}"/>
        </material:Card>
    </Grid>
</UserControl>
