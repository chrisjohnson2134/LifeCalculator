<UserControl
    x:Class="LifeCalculator.Views.CalculatorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controlViewModels="clr-namespace:LifeCalculator.Control.ViewModels;assembly=LifeCalculator.Control"
    xmlns:controlViews="clr-namespace:LifeCalculator.Control.Views;assembly=LifeCalculator.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LifeCalculator.Views"
    xmlns:framework="clr-namespace:LifeCalculator.Framework.SimulatedAccount;assembly=LifeCalculator.Framework"
    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <TabControl>
        <TabItem Header="Life Calculations">
            <Grid Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Header  -->
                <TextBlock
                    Grid.Row="0" Grid.ColumnSpan="2"
                    Margin="10,10,10,4"
                    FontSize="18" FontWeight="Bold" TextWrapping="Wrap"
                    Text="Plan out your life by adding your debts and investments — see where you'll be in 5, 10, or 50 years." />

                <!--  Chart  -->
                <lvc:CartesianChart
                    Grid.Row="1" Grid.Column="0"
                    Margin="5"
                    LegendLocation="Bottom"
                    Series="{Binding ValueCollection}">
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis Title="Year" Labels="{Binding Labels}">
                            <lvc:Axis.Separator>
                                <lvc:Separator Step="1" IsEnabled="False" />
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisX>
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis Title="Value" LabelFormatter="{Binding YFormatter}" />
                    </lvc:CartesianChart.AxisY>
                </lvc:CartesianChart>

                <!--  Add Account / Add Event panel  -->
                <StackPanel
                    Grid.Row="1" Grid.Column="1"
                    Width="240" Margin="10,5,10,5">

                    <GroupBox Header="Add Account" Padding="6" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Margin="2" Content="Type:" Foreground="Black" />
                                <ComboBox
                                    x:Name="AccountTypeSelection"
                                    Grid.Column="1" Margin="2"
                                    BorderBrush="Black" Foreground="Black"
                                    ItemsSource="{Binding AccountTypesList}"
                                    Text="{Binding AccountType}" />
                            </Grid>
                            <ContentControl Margin="0,6,0,0" Content="{Binding CurrentViewModel}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Add Event" Padding="6">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Margin="2" Content="Account:" Foreground="Black" />
                                <ComboBox
                                    x:Name="EventAccountSelection"
                                    Grid.Column="1" Margin="2"
                                    BorderBrush="Black" DisplayMemberPath="Name"
                                    ItemsSource="{Binding AccountsList}"
                                    SelectedItem="{Binding AccountSelected}" />
                            </Grid>
                            <ContentControl Margin="0,6,0,0" Content="{Binding CurrentEventViewModel}" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>

                <!--  Your Accounts list (color-coordinated with the chart)  -->
                <GroupBox
                    Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                    Header="Your Accounts" Margin="5">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AccountsList}">
                            <ItemsControl.Resources>
                                <DataTemplate DataType="{x:Type controlViewModels:ModifyLoanViewModel}">
                                    <Expander Margin="4" IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle
                                                    Width="14" Height="14"
                                                    RadiusX="3" RadiusY="3"
                                                    Margin="0,0,8,0"
                                                    Fill="{Binding SeriesColor}" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="  ·  Loan" Foreground="Gray" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <Border BorderBrush="{Binding SeriesColor}" BorderThickness="0,0,0,3" Padding="6" Margin="0,4,0,0">
                                            <controlViews:ModifyLoan />
                                        </Border>
                                    </Expander>
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type controlViewModels:ModifyCompoundViewModel}">
                                    <Expander Margin="4" IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle
                                                    Width="14" Height="14"
                                                    RadiusX="3" RadiusY="3"
                                                    Margin="0,0,8,0"
                                                    Fill="{Binding SeriesColor}" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="  ·  Investment" Foreground="Gray" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <Border BorderBrush="{Binding SeriesColor}" BorderThickness="0,0,0,3" Padding="6" Margin="0,4,0,0">
                                            <controlViews:ModifyCompound />
                                        </Border>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.Resources>
                        </ItemsControl>
                    </ScrollViewer>
                </GroupBox>
            </Grid>
        </TabItem>
    </TabControl>

</UserControl>
