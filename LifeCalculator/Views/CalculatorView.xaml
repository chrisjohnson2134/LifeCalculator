<UserControl
    x:Class="LifeCalculator.Views.CalculatorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controlViewModels="clr-namespace:LifeCalculator.Control.ViewModels;assembly=LifeCalculator.Control"
    xmlns:controlViews="clr-namespace:LifeCalculator.Control.Views;assembly=LifeCalculator.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LifeCalculator.Views"
    xmlns:framework="clr-namespace:LifeCalculator.Framework.SimulatedAccount;assembly=LifeCalculator.Framework"
    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <TabControl>
        <TabItem Header="Life Calculations">
            <Grid Background="#F5F7FA">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <materialDesign:Card Grid.Row="0" Grid.ColumnSpan="2" Margin="15,15,15,10"
                                     Background="White" Padding="20,15"
                                     materialDesign:ShadowAssist.ShadowDepth="Depth1">
                    <TextBlock TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50">
                        <Run FontSize="22" FontWeight="Bold" Foreground="#1976D2">Life Financial Calculator</Run>
                        <LineBreak/>
                        <Run FontSize="13" Foreground="#607D8B">Plan your financial future by adding accounts (compounds &amp; loans) and events (contributions/payments). Visualize where you'll be in 5, 10, or 50 years!</Run>
                    </TextBlock>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="1" Grid.Column="0" Margin="15,5,10,10"
                                     materialDesign:ShadowAssist.ShadowDepth="Depth2"
                                     Padding="15">
                    <lvc:CartesianChart Series="{Binding ValueCollection}">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis LabelFormatter="{Binding Formatter}" FontSize="12" />
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis FontSize="12" />
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </materialDesign:Card>

                <!--  Account Grid  -->
                <materialDesign:Card Grid.Row="1" Grid.Column="1"
                                     Width="280" Height="550" Margin="5,5,15,10"
                                     materialDesign:ShadowAssist.ShadowDepth="Depth2"
                                     Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Section Header -->
                        <TextBlock Grid.Row="0" Text="Add New Account" FontSize="18" FontWeight="Bold"
                                   Foreground="#1976D2" Margin="0,0,0,15" />

                        <!-- Account Type Buttons -->
                        <Button Grid.Row="1" Content="Add Compound Account"
                                Command="{Binding AddCompoundAccountCommand}"
                                Margin="0,5" Padding="12,8" FontSize="13"
                                Background="#4CAF50" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Height="40"
                                Style="{StaticResource MaterialDesignRaisedButton}" />

                        <Button Grid.Row="2" Content="Add Loan Account"
                                Command="{Binding AddLoanAccountCommand}"
                                Margin="0,5" Padding="12,8" FontSize="13"
                                Background="#F44336" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Height="40"
                                Style="{StaticResource MaterialDesignRaisedButton}" />

                        <!-- Separator -->
                        <Separator Grid.Row="3" Margin="0,15" Background="#E0E0E0" />

                        <!-- Account Form -->
                        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                            <ContentControl Content="{Binding CurrentViewModel}" />
                        </ScrollViewer>
                    </Grid>
                </materialDesign:Card>

                <!--  Events Grid  -->
                <materialDesign:Card Grid.Row="2" Grid.Column="1"
                                     Width="280" Height="500" Margin="5,5,15,15"
                                     materialDesign:ShadowAssist.ShadowDepth="Depth2"
                                     Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Section Header -->
                        <TextBlock Grid.Row="0" Text="Add Events to Accounts" FontSize="18" FontWeight="Bold"
                                   Foreground="#1976D2" Margin="0,0,0,10" />

                        <!-- Instructions -->
                        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,15"
                                   Foreground="#607D8B" FontSize="12">
                            Events are one-time or continuous contributions/payments to your accounts.
                        </TextBlock>

                        <!-- Account Selection -->
                        <TextBlock Grid.Row="2" Text="Select Account:" Foreground="#424242"
                                   Margin="0,5,0,5" FontWeight="SemiBold" FontSize="13" />
                        <ComboBox Grid.Row="3" Margin="0,0,0,15" DisplayMemberPath="Name"
                                  ItemsSource="{Binding AccountsList}"
                                  SelectedItem="{Binding AccountSelected}"
                                  Style="{StaticResource MaterialDesignComboBox}"
                                  materialDesign:HintAssist.Hint="Choose an account" />

                        <!-- Event Form -->
                        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                            <ContentControl Content="{Binding CurrentEventViewModel}"/>
                        </ScrollViewer>
                    </Grid>
                </materialDesign:Card>

                <!--Scroll Through Accounts-->
                <materialDesign:Card Grid.Row="2" Grid.Column="0" Height="320" Margin="15,5,10,15"
                                     materialDesign:ShadowAssist.ShadowDepth="Depth2"
                                     Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Your Accounts" FontSize="18" FontWeight="Bold"
                                   Foreground="#1976D2" Margin="0,0,0,10" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AccountsList}">
                                <ItemsControl.Resources>
                                    <DataTemplate DataType="{x:Type controlViewModels:ModifyLoanViewModel}">
                                        <materialDesign:Card Margin="5" Padding="0"
                                                             materialDesign:ShadowAssist.ShadowDepth="Depth1">
                                            <Expander BorderBrush="#F44336" BorderThickness="0,0,0,3"
                                                      Background="White">
                                                <Expander.Header>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <materialDesign:PackIcon Grid.Column="0" Kind="CreditCard"
                                                                                 Width="20" Height="20" Margin="0,0,10,0"
                                                                                 Foreground="#F44336" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                                                   FontSize="15" VerticalAlignment="Center" Foreground="#2C3E50"/>
                                                    </Grid>
                                                </Expander.Header>
                                                <Border Padding="10" Background="#FAFAFA">
                                                    <controlViews:ModifyLoan />
                                                </Border>
                                            </Expander>
                                        </materialDesign:Card>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type controlViewModels:ModifyCompoundViewModel}">
                                        <materialDesign:Card Margin="5" Padding="0"
                                                             materialDesign:ShadowAssist.ShadowDepth="Depth1">
                                            <Expander BorderBrush="#4CAF50" BorderThickness="0,0,0,3"
                                                      Background="White">
                                                <Expander.Header>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <materialDesign:PackIcon Grid.Column="0" Kind="PiggyBank"
                                                                                 Width="20" Height="20" Margin="0,0,10,0"
                                                                                 Foreground="#4CAF50" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                                                   FontSize="15" VerticalAlignment="Center" Foreground="#2C3E50"/>
                                                    </Grid>
                                                </Expander.Header>
                                                <Border Padding="10" Background="#FAFAFA">
                                                    <controlViews:ModifyCompound/>
                                                </Border>
                                            </Expander>
                                        </materialDesign:Card>
                                    </DataTemplate>
                                </ItemsControl.Resources>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </TabItem>
    </TabControl>
    
</UserControl>
