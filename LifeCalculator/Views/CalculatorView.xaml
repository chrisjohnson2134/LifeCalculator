<UserControl
    x:Class="LifeCalculator.Views.CalculatorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controlViewModels="clr-namespace:LifeCalculator.Control.ViewModels;assembly=LifeCalculator.Control"
    xmlns:controlViews="clr-namespace:LifeCalculator.Control.Views;assembly=LifeCalculator.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LifeCalculator.Views"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:vm="clr-namespace:LifeCalculator.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!--  Shared content for every tab: an "Add" toggle button, its inline form, then the list — all inside ONE ScrollViewer so nothing is ever unreachable, no matter how tall the open form or the list gets.  -->
        <Style x:Key="TabScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Padding" Value="4,12,4,12" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource ParchmentBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!--
                The chart card carries its own controls and legend rows, so it needs a floor of
                its own; the tabs hold the forms and lists and need the larger share. MinHeights
                stop either being squeezed to nothing on a short window.
            -->
            <RowDefinition Height="1.8*" MinHeight="240" />
            <RowDefinition Height="3.4*" MinHeight="260" />
        </Grid.RowDefinitions>

        <!--  Summary cards  -->
        <UniformGrid Grid.Row="0" Rows="1" Margin="16,16,16,4">
            <Border Style="{StaticResource LedgerCard}" Margin="4" BorderThickness="1,1,1,3" BorderBrush="{StaticResource HairlineBrush}">
                <StackPanel>
                    <TextBlock Text="TOTAL DEBT" Style="{StaticResource EyebrowText}" Foreground="{StaticResource InkMutedBrush}" />
                    <TextBlock Text="{Binding TotalDebt, StringFormat=C0}" Style="{StaticResource DataFigureText}" FontSize="22" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource LedgerCard}" Margin="4" BorderThickness="1,1,1,3" BorderBrush="{StaticResource SageBrush}">
                <StackPanel>
                    <TextBlock Text="TOTAL ASSETS" Style="{StaticResource EyebrowText}" Foreground="{StaticResource InkMutedBrush}" />
                    <TextBlock Text="{Binding TotalAssets, StringFormat=C0}" Style="{StaticResource DataFigureText}" FontSize="22" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource LedgerCard}" Margin="4" BorderThickness="1,1,1,3" BorderBrush="{StaticResource BrassBrush}">
                <StackPanel>
                    <TextBlock Text="NET WORTH" Style="{StaticResource EyebrowText}" Foreground="{StaticResource InkMutedBrush}" />
                    <TextBlock Text="{Binding NetWorth, StringFormat=C0}" Style="{StaticResource DataFigureText}" FontSize="22" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource LedgerCard}" Margin="4">
                <StackPanel>
                    <TextBlock Text="DEBT-FREE" Style="{StaticResource EyebrowText}" Foreground="{StaticResource InkMutedBrush}" />
                    <TextBlock Text="{Binding DebtFreeDateText}" Style="{StaticResource DisplayText}" FontSize="16" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource LedgerCard}" Margin="4" BorderThickness="1,1,1,3">
                <StackPanel>
                    <TextBlock Text="MONTHLY SURPLUS" Style="{StaticResource EyebrowText}" Foreground="{StaticResource InkMutedBrush}" />
                    <TextBlock Text="{Binding MonthlySurplus, StringFormat=C0}" FontSize="22" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataFigureText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSurplusNegative}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource BrickBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!--  Chart view selector + payoff strategy  -->
        <DockPanel Grid.Row="1" Margin="20,4,20,8" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource SegmentedToggle}" GroupName="ChartView" Content="Net worth"
                             IsChecked="{Binding SelectedChartView, Converter={StaticResource EqualValueToParameterConverter}, ConverterParameter=NetWorth}" />
                <RadioButton Style="{StaticResource SegmentedToggle}" GroupName="ChartView" Content="Account growth"
                             IsChecked="{Binding SelectedChartView, Converter={StaticResource EqualValueToParameterConverter}, ConverterParameter=AccountGrowth}" />
                <RadioButton Style="{StaticResource SegmentedToggle}" GroupName="ChartView" Content="Debt payoff"
                             IsChecked="{Binding SelectedChartView, Converter={StaticResource EqualValueToParameterConverter}, ConverterParameter=DebtPayoff}" />
                <RadioButton Style="{StaticResource SegmentedToggle}" GroupName="ChartView" Content="Emergency fund"
                             IsChecked="{Binding SelectedChartView, Converter={StaticResource EqualValueToParameterConverter}, ConverterParameter=EmergencyFund}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Payoff strategy:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource BodyMutedText}" />
                <ComboBox Width="230" Style="{StaticResource EnumComboBox}" ItemsSource="{Binding PayoffStrategies}" SelectedItem="{Binding PayoffStrategy}" />
            </StackPanel>
        </DockPanel>

        <!--  Chart  -->
        <Border Grid.Row="2" Margin="12,4,12,4" Style="{StaticResource LedgerCard}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Style + range controls, and a line saying what the view shows  -->
                <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0"
                                    Visibility="{Binding SupportsChartStyle, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <RadioButton Style="{StaticResource SegmentedToggle}" GroupName="ChartStyle" Content="Line"
                                         IsChecked="{Binding SelectedChartStyle, Converter={StaticResource EqualValueToParameterConverter}, ConverterParameter=Line}" />
                            <RadioButton Style="{StaticResource SegmentedToggle}" GroupName="ChartStyle" Content="Area"
                                         IsChecked="{Binding SelectedChartStyle, Converter={StaticResource EqualValueToParameterConverter}, ConverterParameter=Area}" />
                            <RadioButton Style="{StaticResource SegmentedToggle}" GroupName="ChartStyle" Content="Bars"
                                         Visibility="{Binding SupportsBarStyle, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         IsChecked="{Binding SelectedChartStyle, Converter={StaticResource EqualValueToParameterConverter}, ConverterParameter=Bars}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding SupportsChartStyle, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <RadioButton Style="{StaticResource SegmentedToggle}" GroupName="ChartRange" Content="1y"
                                         IsChecked="{Binding SelectedChartRange, Converter={StaticResource EqualValueToParameterConverter}, ConverterParameter=OneYear}" />
                            <RadioButton Style="{StaticResource SegmentedToggle}" GroupName="ChartRange" Content="5y"
                                         IsChecked="{Binding SelectedChartRange, Converter={StaticResource EqualValueToParameterConverter}, ConverterParameter=FiveYears}" />
                            <RadioButton Style="{StaticResource SegmentedToggle}" GroupName="ChartRange" Content="10y"
                                         IsChecked="{Binding SelectedChartRange, Converter={StaticResource EqualValueToParameterConverter}, ConverterParameter=TenYears}" />
                            <RadioButton Style="{StaticResource SegmentedToggle}" GroupName="ChartRange" Content="30y"
                                         IsChecked="{Binding SelectedChartRange, Converter={StaticResource EqualValueToParameterConverter}, ConverterParameter=ThirtyYears}" />
                            <RadioButton Style="{StaticResource SegmentedToggle}" GroupName="ChartRange" Content="All"
                                         IsChecked="{Binding SelectedChartRange, Converter={StaticResource EqualValueToParameterConverter}, ConverterParameter=All}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding ChartCaption}" Style="{StaticResource BodyMutedText}" FontSize="11"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                </DockPanel>

                <Grid Grid.Row="1">
                    <lvc:CartesianChart
                        Visibility="{Binding IsNetWorthChartVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Series="{Binding NetWorthSeriesCollection}"
                        XAxes="{Binding NetWorthDateAxes}"
                        YAxes="{Binding NetWorthCurrencyAxes}" />
                    <lvc:CartesianChart
                        Visibility="{Binding IsGrowthChartVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Series="{Binding GrowthSeriesCollection}"
                        XAxes="{Binding GrowthDateAxes}"
                        YAxes="{Binding GrowthCurrencyAxes}" />

                    <!--  Debt payoff, drawn either as falling balances or as payoff-order bars  -->
                    <lvc:CartesianChart
                        Visibility="{Binding IsDebtLineVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Series="{Binding DebtSeriesCollection}"
                        XAxes="{Binding DebtDateAxes}"
                        YAxes="{Binding DebtCurrencyAxes}" />
                    <lvc:CartesianChart
                        Visibility="{Binding IsDebtBarsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Series="{Binding DebtTimelineSeries}"
                        XAxes="{Binding DebtTimelineXAxes}"
                        YAxes="{Binding DebtTimelineYAxes}" />

                    <!--
                        Emergency fund gauge. Only the percentage sits inside the ring — the
                        sentence goes beside it, because wrapped text over the donut collided
                        with the arc and was unreadable at any size.
                    -->
                    <Grid Visibility="{Binding IsEmergencyChartVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="220" Margin="8">
                            <lvc:PieChart Series="{Binding EmergencyGaugeSeries}" InitialRotation="-90" MaxAngle="360" />
                            <TextBlock
                                Text="{Binding EmergencyGaugeHeadline}"
                                Style="{StaticResource DataFigureText}" FontSize="24"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False" />
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,8,0">
                            <TextBlock Text="EMERGENCY FUND" Style="{StaticResource EyebrowText}" Foreground="{StaticResource InkMutedBrush}" />
                            <TextBlock Text="{Binding EmergencyGaugeCaption}" Style="{StaticResource BodyMutedText}"
                                       TextWrapping="Wrap" MaxWidth="420" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!--  Clickable legend: hide an account to get it out of the way  -->
                <ItemsControl Grid.Row="2" ItemsSource="{Binding SeriesToggles}" Margin="0,10,0,0"
                              Visibility="{Binding SupportsLegend, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource LegendToggle}" IsChecked="{Binding IsVisible}" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="{Binding Color}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="11" />
                                </StackPanel>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!--  Section tabs: Debts / Investments / Retirement / Income  -->
        <TabControl Grid.Row="3" Margin="12,4,12,12">
            <TabItem Header="Debts">
                <ScrollViewer Style="{StaticResource TabScrollViewer}">
                    <StackPanel>
                        <Button Content="+ Add Debt" Command="{Binding ToggleAddDebtCommand}" Style="{StaticResource LedgerSecondaryButton}" HorizontalAlignment="Left" Margin="4,0,4,0" />
                        <Border
                            Style="{StaticResource LedgerCard}" Margin="4,10,4,0"
                            Visibility="{Binding IsAddDebtOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <controlViews:AddLoan DataContext="{Binding AddDebtViewModel}" />
                        </Border>

                        <ItemsControl ItemsSource="{Binding Debts}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type controlViewModels:ModifyLoanViewModel}">
                                    <Expander Margin="4" IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Margin="0,0,8,0" Fill="{Binding SeriesColor}" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding MonthlyPayment, StringFormat='  ·  {0:C0}/mo'}" Style="{StaticResource BodyMutedText}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <Border BorderBrush="{Binding SeriesColor}" BorderThickness="0,0,0,3" Padding="6" Margin="0,4,0,0">
                                            <controlViews:ModifyLoan />
                                        </Border>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Emergency Fund">
                <ScrollViewer Style="{StaticResource TabScrollViewer}">
                    <controlViews:EmergencyFundPanel DataContext="{Binding EmergencyFund}" />
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Investments">
                <ScrollViewer Style="{StaticResource TabScrollViewer}">
                    <StackPanel>
                        <Button Content="+ Add Investment" Command="{Binding ToggleAddInvestmentCommand}" Style="{StaticResource LedgerSecondaryButton}" HorizontalAlignment="Left" Margin="4,0,4,0" />
                        <Border
                            Style="{StaticResource LedgerCard}" Margin="4,10,4,0"
                            Visibility="{Binding IsAddInvestmentOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <controlViews:AddCompound DataContext="{Binding AddInvestmentViewModel}" />
                        </Border>

                        <ItemsControl ItemsSource="{Binding Investments}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type controlViewModels:ModifyCompoundViewModel}">
                                    <Expander Margin="4" IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Margin="0,0,8,0" Fill="{Binding SeriesColor}" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="  ·  Investment" Style="{StaticResource BodyMutedText}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <Border BorderBrush="{Binding SeriesColor}" BorderThickness="0,0,0,3" Padding="6" Margin="0,4,0,0">
                                            <controlViews:ModifyCompound />
                                        </Border>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Retirement">
                <ScrollViewer Style="{StaticResource TabScrollViewer}">
                    <StackPanel>
                        <Button Content="+ Add Retirement Account" Command="{Binding ToggleAddRetirementCommand}" Style="{StaticResource LedgerSecondaryButton}" HorizontalAlignment="Left" Margin="4,0,4,0" />
                        <Border
                            Style="{StaticResource LedgerCard}" Margin="4,10,4,0"
                            Visibility="{Binding IsAddRetirementOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <controlViews:AddRetirement DataContext="{Binding AddRetirementViewModel}" />
                        </Border>

                        <ItemsControl ItemsSource="{Binding RetirementAccounts}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type controlViewModels:ModifyRetirementViewModel}">
                                    <Expander Margin="4" IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Margin="0,0,8,0" Fill="{Binding SeriesColor}" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="  ·  " Style="{StaticResource BodyMutedText}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding AccountKind, Converter={StaticResource EnumDescriptionConverter}}" Style="{StaticResource BodyMutedText}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <Border BorderBrush="{Binding SeriesColor}" BorderThickness="0,0,0,3" Padding="6" Margin="0,4,0,0">
                                            <controlViews:ModifyRetirement />
                                        </Border>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>

</UserControl>
