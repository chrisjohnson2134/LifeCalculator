<UserControl
    x:Class="LifeCalculator.Views.RegisterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LifeCalculator.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pwBox="clr-namespace:LifeCalculator.Control.PasswordBox;assembly=LifeCalculator.Control"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" MinWidth="380" />
            <ColumnDefinition Width="1*" MinWidth="380" />
        </Grid.ColumnDefinitions>

        <!--  Left: what you get, as three ledger entries  -->
        <Grid Grid.Column="0" Background="{StaticResource InkBrush}">
            <StackPanel VerticalAlignment="Center" Margin="56,0,48,0" MaxWidth="440" HorizontalAlignment="Left">
                <TextBlock Text="LIFE CALCULATOR" Foreground="{StaticResource BrassBrush}" FontFamily="{StaticResource BodyFontFamily}" FontSize="12" FontWeight="SemiBold" />

                <TextBlock
                    Text="Start the ledger."
                    Foreground="{StaticResource ParchmentBrush}"
                    FontFamily="{StaticResource DisplayFontFamily}"
                    FontSize="46" FontWeight="SemiBold"
                    TextWrapping="Wrap" Margin="0,14,0,0" />

                <TextBlock
                    Text="Everything stays on this machine. No accounts to link, no data leaves your desk."
                    Foreground="#93A2AB"
                    FontFamily="{StaticResource BodyFontFamily}"
                    FontSize="15" TextWrapping="Wrap"
                    Margin="0,16,0,0" />

                <Border BorderBrush="#2C3A46" BorderThickness="0,1,0,0" Margin="0,34,0,26" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Width="7" Height="7" CornerRadius="4" Background="{StaticResource BrassBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Text="Avalanche or snowball, side by side" Foreground="#C4CED4" FontFamily="{StaticResource BodyFontFamily}" FontSize="14" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Width="7" Height="7" CornerRadius="4" Background="{StaticResource BrassBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Text="401(k) growth with employer matching" Foreground="#C4CED4" FontFamily="{StaticResource BodyFontFamily}" FontSize="14" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="7" Height="7" CornerRadius="4" Background="{StaticResource BrassBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Text="Net worth, month by month, for decades" Foreground="#C4CED4" FontFamily="{StaticResource BodyFontFamily}" FontSize="14" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!--  Right: the form  -->
        <Grid Grid.Column="1" Background="{StaticResource ParchmentBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel VerticalAlignment="Center" Margin="52,36,52,36" MaxWidth="360">
                    <TextBlock Text="Create your account" Style="{StaticResource DisplayLargeText}" FontSize="28" />
                    <TextBlock Text="Takes about a minute." Style="{StaticResource BodyMutedText}" Margin="0,6,0,26" />

                    <TextBlock Text="EMAIL" Style="{StaticResource EyebrowText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="USERNAME" Style="{StaticResource EyebrowText}" Margin="0,16,0,4" />
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="PASSWORD" Style="{StaticResource EyebrowText}" Margin="0,16,0,4" />
                    <pwBox:BindablePasswordBox Password="{Binding Password, Mode=TwoWay}" />

                    <TextBlock Text="CONFIRM PASSWORD" Style="{StaticResource EyebrowText}" Margin="0,16,0,4" />
                    <pwBox:BindablePasswordBox Password="{Binding ConfirmPassword, Mode=TwoWay}" />

                    <Button
                        Margin="0,26,0,0"
                        HorizontalAlignment="Stretch"
                        Command="{Binding RegisterCommand}"
                        Content="Create Account"
                        IsDefault="True"
                        Style="{StaticResource LedgerPrimaryButton}" />

                    <TextBlock
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        DataContext="{Binding RegisterErrorMessage}"
                        FontSize="13"
                        Foreground="{StaticResource BrickBrush}"
                        TextWrapping="Wrap" TextAlignment="Center"
                        Text="{Binding Message}"
                        Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Margin="0,28,0,0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <TextBlock Text="Already have an account?" Style="{StaticResource BodyMutedText}" VerticalAlignment="Center" />
                        <Button
                            Margin="6,0,0,0" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            Command="{Binding ViewLoginCommand}"
                            Content="Log in"
                            Cursor="Hand"
                            FontFamily="{StaticResource BodyFontFamily}"
                            FontSize="13" FontWeight="SemiBold"
                            Foreground="{StaticResource BrassDarkBrush}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
