<UserControl
    x:Class="LifeCalculator.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pwBox="clr-namespace:LifeCalculator.Control.PasswordBox;assembly=LifeCalculator.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LifeCalculator.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <!--  Two panes: the ledger "statement" on the left tells the story, the form on the right does the work.  -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" MinWidth="380" />
            <ColumnDefinition Width="1*" MinWidth="380" />
        </Grid.ColumnDefinitions>

        <!--  Left: dark ledger panel  -->
        <Grid Grid.Column="0" Background="{StaticResource InkBrush}">
            <StackPanel VerticalAlignment="Center" Margin="56,0,48,0" MaxWidth="440" HorizontalAlignment="Left">
                <TextBlock Text="LIFE CALCULATOR" Foreground="{StaticResource BrassBrush}" FontFamily="{StaticResource BodyFontFamily}" FontSize="12" FontWeight="SemiBold" />

                <TextBlock
                    Text="Know your number."
                    Foreground="{StaticResource ParchmentBrush}"
                    FontFamily="{StaticResource DisplayFontFamily}"
                    FontSize="46" FontWeight="SemiBold"
                    TextWrapping="Wrap" Margin="0,14,0,0" />

                <TextBlock
                    Text="Every debt, every account, every month — projected out to the day you're free of them."
                    Foreground="#93A2AB"
                    FontFamily="{StaticResource BodyFontFamily}"
                    FontSize="15" TextWrapping="Wrap"
                    Margin="0,16,0,0" />

                <Border BorderBrush="#2C3A46" BorderThickness="0,1,0,0" Margin="0,34,0,26" />

                <!--  Sample ledger rows: the product's actual output, used as the hero  -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Car loan" Foreground="#93A2AB" FontFamily="{StaticResource BodyFontFamily}" FontSize="13" />
                    <TextBlock Grid.Column="1" Text="paid off Mar 2027" Foreground="{StaticResource ParchmentBrush}" FontFamily="{StaticResource DataFontFamily}" FontSize="13" />
                </Grid>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="401(k)" Foreground="#93A2AB" FontFamily="{StaticResource BodyFontFamily}" FontSize="13" />
                    <TextBlock Grid.Column="1" Text="$412,900 by 2055" Foreground="{StaticResource ParchmentBrush}" FontFamily="{StaticResource DataFontFamily}" FontSize="13" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Net worth" Foreground="{StaticResource BrassBrush}" FontFamily="{StaticResource BodyFontFamily}" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="trending up" Foreground="{StaticResource BrassBrush}" FontFamily="{StaticResource DataFontFamily}" FontSize="13" FontWeight="SemiBold" />
                </Grid>
            </StackPanel>
        </Grid>

        <!--  Right: the form  -->
        <Grid Grid.Column="1" Background="{StaticResource ParchmentBrush}">
            <StackPanel VerticalAlignment="Center" Margin="52,0,52,0" MaxWidth="360">
                <TextBlock Text="Welcome back" Style="{StaticResource DisplayLargeText}" FontSize="28" />
                <TextBlock Text="Pick up where you left off." Style="{StaticResource BodyMutedText}" Margin="0,6,0,28" />

                <TextBlock Text="USERNAME" Style="{StaticResource EyebrowText}" Margin="0,0,0,4" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="PASSWORD" Style="{StaticResource EyebrowText}" Margin="0,18,0,4" />
                <pwBox:BindablePasswordBox x:Name="pwBox" Password="{Binding Password, Mode=TwoWay}" />

                <Button
                    Margin="0,26,0,0"
                    HorizontalAlignment="Stretch"
                    Command="{Binding LoginCommand}"
                    Content="Log In"
                    IsDefault="True"
                    Style="{StaticResource LedgerPrimaryButton}" />

                <TextBlock
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    DataContext="{Binding LoginErrorMessage}"
                    FontSize="13"
                    Foreground="{StaticResource BrickBrush}"
                    TextWrapping="Wrap" TextAlignment="Center"
                    Text="{Binding Message}"
                    Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Margin="0,28,0,0" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <TextBlock Text="New here?" Style="{StaticResource BodyMutedText}" VerticalAlignment="Center" />
                    <Button
                        Margin="6,0,0,0" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Command="{Binding ViewRegisterCommand}"
                        Content="Create an account"
                        Cursor="Hand"
                        FontFamily="{StaticResource BodyFontFamily}"
                        FontSize="13" FontWeight="SemiBold"
                        Foreground="{StaticResource BrassDarkBrush}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>

</UserControl>
