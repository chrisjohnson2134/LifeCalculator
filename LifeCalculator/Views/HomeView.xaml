<UserControl
    x:Class="LifeCalculator.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controlViewModels="clr-namespace:LifeCalculator.Control.ViewModels;assembly=LifeCalculator.Control"
    xmlns:controlViews="clr-namespace:LifeCalculator.Control.Views;assembly=LifeCalculator.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LifeCalculator.Views"
    xmlns:framework="clr-namespace:LifeCalculator.Framework.SimulatedAccount;assembly=LifeCalculator.Framework"
    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#F5F7FA">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="600">
            <materialDesign:Card Padding="40" materialDesign:ShadowAssist.ShadowDepth="Depth3">
                <StackPanel>
                    <materialDesign:PackIcon Kind="RocketLaunch" Width="80" Height="80"
                                             HorizontalAlignment="Center" Foreground="#1976D2" Margin="0,0,0,20"/>
                    <TextBlock Text="Coming Soon!" HorizontalAlignment="Center"
                               FontSize="36" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,10"/>
                    <TextBlock Text="Exciting features are on the way!" HorizontalAlignment="Center"
                               FontSize="18" Foreground="#607D8B" Margin="0,0,0,20" TextWrapping="Wrap" TextAlignment="Center"/>
                    <Separator Margin="0,10" Background="#E0E0E0"/>
                    <TextBlock Text="In the meantime, explore:" HorizontalAlignment="Center"
                               FontSize="16" Foreground="#424242" Margin="0,20,0,15" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <materialDesign:PackIcon Kind="Calculator" Width="24" Height="24" Foreground="#4CAF50" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Life Calculator" FontSize="14" Foreground="#2C3E50" VerticalAlignment="Center" Margin="0,0,30,0"/>
                        <materialDesign:PackIcon Kind="Bank" Width="24" Height="24" Foreground="#2196F3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Financial Profile" FontSize="14" Foreground="#2C3E50" VerticalAlignment="Center" Margin="0,0,30,0"/>
                        <materialDesign:PackIcon Kind="AttachMoney" Width="24" Height="24" Foreground="#FF9800" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Budget" FontSize="14" Foreground="#2C3E50" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </Grid>
</UserControl>
